PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=medical-chatbot
LLAMA_MODEL_PATH=model/llama-2-7b-chat.ggmlv3.q4_0.bin

# Safety layer tuning
RETRIEVAL_K=3
# Minimum Pinecone cosine similarity (range -1 to 1) required before the LLM
# is allowed to answer. Below this, the bot refuses instead of guessing.
CONFIDENCE_THRESHOLD=0.5

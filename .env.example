PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=medical-chatbot-medcpt

# Used for the chat LLM (gpt-4o-mini) and for build_graph.py's extraction —
# both cost money. Extraction makes hundreds of calls per run; budget before
# re-running it on a larger corpus.
OPENAI_API_KEY=your-openai-api-key

# Cancer department's knowledge graph (brew install neo4j; see README).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# Safety layer tuning
RETRIEVAL_K=3
# Minimum Pinecone cosine similarity (range -1 to 1) required before the LLM
# is allowed to answer. Below this, the bot refuses instead of guessing.
CONFIDENCE_THRESHOLD=0.5

# Image captioning (general dept, src/multimodal.py) makes one paid OpenAI
# vision call per embedded image in a PDF — opt in deliberately.
ENABLE_IMAGE_CAPTIONING=false
